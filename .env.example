APP_NAME="Mening Fikrim"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=uz
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
LOG_CHANNEL=stack
LOG_LEVEL=debug
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=mening_fikrim_active
DB_USERNAME=
DB_PASSWORD=
QUEUE_CONNECTION=database
DB_QUEUE=scraping
DB_QUEUE_RETRY_AFTER=960
CACHE_STORE=database
SESSION_DRIVER=file
MAIL_MAILER=log
SCRAPING_REQUEST_DELAY_MS=2000
SCRAPING_HTTP_TIMEOUT=30
SCRAPING_PDF_TIMEOUT=90
SCRAPING_MAX_RETRIES=3
SCRAPING_JOB_TIMEOUT=900
SCRAPING_RECHECK_DAYS=90
SCRAPING_DAILY_TIME=02:00

# Bounded P2 only; never enable unattended daily/full imports.
SCRAPING_LIVE_ENABLED=false
SCRAPING_REQUEST_BUDGET=400
SCRAPING_PAGE_BUDGET=8
SCRAPING_MAX_PDF_PAGES=250
SCRAPING_MAX_OCR_PAGES=40
SCRAPING_PARSE_TIMEOUT=600
SCRAPING_OCR_PAGE_TIMEOUT=45
SCRAPING_PDFTOTEXT_BINARY=pdftotext
SCRAPING_PDFINFO_BINARY=pdfinfo
SCRAPING_PDFTOHTML_BINARY=pdftohtml
SCRAPING_PDFTOPPM_BINARY=pdftoppm
SCRAPING_TESSERACT_BINARY=tesseract
SCRAPING_TESSDATA_PREFIX=
SCRAPING_PROCESS_LIBRARY_PATH=
SCRAPING_SCHEDULER_ENABLED=false

SCRAPING_WORKERS=1
SCRAPING_PDF_LAYOUT_ENABLED=false
SCRAPING_PYTHON_BINARY=python3
