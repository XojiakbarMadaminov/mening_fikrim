        "relname": "scrape_runs",
        "conname": "runs_completion_check",
        "definition": "CHECK ((((status)::text <> 'completed'::text) OR ((failed_count = 0) AND ((checkpoint @> '{\"quality_passed\": true, \"jobs_reconciled\": true, \"coverage_verified\": true, \"discovery_finished\": true, \"languages_complete\": true}'::jsonb) IS TRUE))))"
