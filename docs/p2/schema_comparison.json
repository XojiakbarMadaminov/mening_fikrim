        "conname": "runs_counts_check",
        "definition": "CHECK (((processed_count >= 0) AND (created_count >= 0) AND (updated_count >= 0) AND (failed_count >= 0) AND ((created_count + updated_count) <= processed_count) AND (failed_count <= processed_count)))"
      },
      {
        "relname": "scrape_runs",
        "conname": "runs_mode_check",
