        "relname": "scrape_runs",
        "conname": "runs_status_check",
        "definition": "CHECK (((status)::text = ANY ((ARRAY['running'::character varying, 'completed'::character varying, 'completed_with_errors'::character varying, 'failed'::character varying])::text[])))"
